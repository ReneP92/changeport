{{- /*
The one template every customer's Kafka cluster is generated from, rendered
by internal/provisioning from a validated Spec: its Profile sizes the cluster
and its Platform says where it runs.
*/ -}}
{{- define "labels" }}
    app.kubernetes.io/managed-by: {{ .ManagedBy }}
    changeport.io/tenant: {{ .Tenant }}
{{- end -}}
apiVersion: v1
kind: Namespace
metadata:
  name: {{ .Namespace }}
  labels:
{{- template "labels" . }}
---
apiVersion: kafka.strimzi.io/v1
kind: KafkaNodePool
metadata:
  name: {{ .NodePoolName }}
  namespace: {{ .Namespace }}
  labels:
    strimzi.io/cluster: {{ .ClusterName }}
{{- template "labels" . }}
spec:
  replicas: {{ .Profile.Replicas }}
  roles:
    - controller
    - broker
  resources:
    requests:
      cpu: "{{ .Profile.CPURequest }}"
      memory: "{{ .Profile.Memory }}"
    limits:
      memory: "{{ .Profile.Memory }}"
  storage:
    type: jbod
    volumes:
      - id: 0
        type: persistent-claim
        size: "{{ .Profile.StorageSize }}"
        class: "{{ .Platform.StorageClass }}"
        deleteClaim: false
        kraftMetadata: shared
---
apiVersion: kafka.strimzi.io/v1
kind: Kafka
metadata:
  name: {{ .ClusterName }}
  namespace: {{ .Namespace }}
  labels:
{{- template "labels" . }}
spec:
  kafka:
    version: {{ .KafkaVersion }}
    metadataVersion: {{ .MetadataVersion }}
{{- if gt .Profile.Zones 1 }}
    rack:
      topologyKey: {{ .ZoneTopologyKey }}
{{- end }}
    listeners:
      - name: plain
        port: 9092
        type: internal
        tls: false
      - name: tls
        port: 9093
        type: internal
        tls: true
    config:
      default.replication.factor: {{ .Profile.ReplicationFactor }}
      min.insync.replicas: {{ .Profile.MinInsyncReplicas }}
      offsets.topic.replication.factor: {{ .Profile.ReplicationFactor }}
      transaction.state.log.replication.factor: {{ .Profile.ReplicationFactor }}
      transaction.state.log.min.isr: {{ .Profile.MinInsyncReplicas }}
  entityOperator:
    topicOperator: {}
    userOperator: {}
