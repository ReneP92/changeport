{{- /*
The one template every customer's Kafka cluster is generated from, rendered
by internal/provisioning from a validated Spec: its Profile sizes the cluster
and its Platform says where it runs.
*/ -}}
{{- define "labels" }}
    app.kubernetes.io/managed-by: {{ .ManagedBy }}
    changeport.io/tenant: {{ quote .Tenant }}
{{- end -}}
{{- /* Flow-style values that place pods on the customer's dedicated nodes, usable at any depth. */ -}}
{{- define "tenant-node-affinity" -}}
{requiredDuringSchedulingIgnoredDuringExecution: {nodeSelectorTerms: [{matchExpressions: [{key: changeport.io/tenant, operator: In, values: [{{ quote .Tenant }}]}]}]}}
{{- end -}}
{{- define "tenant-tolerations" -}}
[{key: changeport.io/tenant, operator: Equal, value: {{ quote .Tenant }}, effect: NoSchedule}]
{{- end -}}
{{- define "broker-selector" -}}
{matchLabels: {strimzi.io/cluster: {{ quote .ClusterName }}, strimzi.io/pool-name: {{ .NodePoolName }}}}
{{- end -}}
{{- /* The labels of the objects of the CDC runtime, which the provisioner deletes once they are no longer rendered. */ -}}
{{- define "cdc-labels" }}
    {{ .CDC.PartLabel }}: {{ .CDC.Part }}
{{- template "labels" . }}
{{- end -}}
{{- define "connect-selector" -}}
{matchLabels: {strimzi.io/cluster: {{ .CDC.ConnectCluster }}, strimzi.io/kind: KafkaConnect}}
{{- end -}}
{{- define "registry-selector" -}}
{matchLabels: {app.kubernetes.io/name: {{ .CDC.Registry }}}}
{{- end -}}
{{- /* Places a pod of the CDC runtime on the customer's dedicated nodes, never on a broker's node. */ -}}
{{- define "cdc-placement" }}
      affinity:
{{- if .Platform.DedicatedNodes }}
        nodeAffinity: {{ template "tenant-node-affinity" . }}
{{- end }}
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - topologyKey: kubernetes.io/hostname
              labelSelector: {{ template "broker-selector" . }}
{{- if .Platform.DedicatedNodes }}
      tolerations: {{ template "tenant-tolerations" . }}
{{- end }}
{{- end -}}
apiVersion: v1
kind: Namespace
metadata:
  name: {{ .Namespace }}
  labels:
{{- template "labels" . }}
{{- if .DeletionProtection }}
    # The admission policy refuses deleting the namespace of a protected
    # customer, with everything in it.
    {{ .DeletionProtectionLabel }}: "true"
{{- end }}
{{- with .Platform.DedicatedNodes }}
---
# The customer's own nodes: EKS Auto Mode launches them for this NodePool
# only, labelled and tainted with the tenant so that no other pods run there.
apiVersion: eks.amazonaws.com/v1
kind: NodeClass
metadata:
  name: {{ $.DedicatedNodePool }}
  labels:
{{- template "labels" $ }}
spec:
  role: {{ .NodeRole }}
  subnetSelectorTerms:
    - tags:
{{- range $key, $value := .SubnetTags }}
        {{ $key }}: {{ printf "%q" $value }}
{{- end }}
  securityGroupSelectorTerms:
    - tags:
{{- range $key, $value := .SecurityGroupTags }}
        {{ $key }}: {{ printf "%q" $value }}
{{- end }}
  # Shows each customer's nodes in cost allocation.
  tags:
    changeport.io/tenant: {{ quote $.Tenant }}
---
apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: {{ $.DedicatedNodePool }}
  labels:
{{- template "labels" $ }}
spec:
  template:
    metadata:
      labels:
        changeport.io/tenant: {{ quote $.Tenant }}
    spec:
      nodeClassRef:
        group: eks.amazonaws.com
        kind: NodeClass
        name: {{ $.DedicatedNodePool }}
      taints:
        - key: changeport.io/tenant
          value: {{ quote $.Tenant }}
          effect: NoSchedule
      requirements:
        - key: kubernetes.io/arch
          operator: In
          values: [arm64]
        - key: karpenter.sh/capacity-type
          operator: In
          values: [on-demand]
        - key: eks.amazonaws.com/instance-family
          operator: In
          values: [{{ range $i, $family := .InstanceFamilies }}{{ if $i }}, {{ end }}{{ $family }}{{ end }}]
        - key: eks.amazonaws.com/instance-cpu
          operator: In
          values: ["{{ $.Profile.NodeCPUs }}"]
      # The longest node lifetime EKS Auto Mode allows. Expiry ignores the
      # disruption budgets; Strimzi Drain Cleaner turns the eviction of a
      # broker into a rolling restart by the Strimzi operator instead.
      expireAfter: 504h
      terminationGracePeriod: 24h
  disruption:
    consolidationPolicy: WhenEmpty
    consolidateAfter: 5m
    budgets:
      # One node at a time.
      - nodes: "1"
      # Drifted nodes, mostly after new Auto Mode AMIs (about weekly), are
      # replaced only between 06:00 and 10:00 UTC, at night in us-east-1.
      - nodes: "0"
        reasons: [Drifted]
        schedule: "0 10 * * *"
        duration: 20h
  limits:
    cpu: "{{ $.DedicatedNodeCPULimit }}"
{{- end }}
{{- with .Platform.TieredStorage.StaticCredentials }}
---
# The keys of the local object store, for the brokers' tiered storage.
apiVersion: v1
kind: Secret
metadata:
  name: tiered-storage-credentials
  namespace: {{ $.Namespace }}
  labels:
{{- template "labels" $ }}
stringData:
  AWS_ACCESS_KEY_ID: {{ quote .AccessKeyID }}
  AWS_SECRET_ACCESS_KEY: {{ quote .SecretAccessKey }}
{{- end }}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: external-listener
  namespace: {{ .Namespace }}
  labels:
{{- template "labels" . }}
spec:
  # One wildcard name covers the bootstrap name and every broker's name.
  dnsNames:
    - "*.{{ .Domain }}"
  secretName: {{ .ExternalListenerSecret }}
  privateKey:
    algorithm: ECDSA
    size: 256
    # Kafka only loads PEM private keys in PKCS#8.
    encoding: PKCS8
  issuerRef:
    group: cert-manager.io
    kind: ClusterIssuer
    name: {{ .Platform.CertificateIssuer }}
---
apiVersion: kafka.strimzi.io/v1
kind: KafkaNodePool
metadata:
  name: {{ .NodePoolName }}
  namespace: {{ .Namespace }}
  labels:
    strimzi.io/cluster: {{ quote .ClusterName }}
{{- template "labels" . }}
spec:
  replicas: {{ .Profile.Replicas }}
  roles:
    - controller
    - broker
  resources:
    requests:
      cpu: "{{ .Profile.CPURequest }}"
      memory: "{{ .Profile.Memory }}"
    limits:
      memory: "{{ .Profile.Memory }}"
  storage:
    type: jbod
    volumes:
      - id: 0
        type: persistent-claim
        size: "{{ .Profile.StorageSize }}"
        class: "{{ .Platform.StorageClass }}"
        deleteClaim: false
        kraftMetadata: shared
  template:
    pod:
      volumes:
        # The tiered storage plugin's cache of chunks fetched back from S3.
        - name: tiered-storage-cache
          emptyDir:
            sizeLimit: 3Gi
      affinity:
{{- if .Platform.DedicatedNodes }}
        nodeAffinity: {{ template "tenant-node-affinity" . }}
{{- end }}
        # One broker per node.
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - topologyKey: kubernetes.io/hostname
              labelSelector: {{ template "broker-selector" . }}
{{- if gt .Profile.Zones 1 }}
      # Brokers spread evenly over the zones, or wait until they can.
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: {{ .ZoneTopologyKey }}
          whenUnsatisfiable: DoNotSchedule
          labelSelector: {{ template "broker-selector" . }}
{{- end }}
{{- if .Platform.DedicatedNodes }}
      tolerations: {{ template "tenant-tolerations" . }}
{{- end }}
    kafkaContainer:
      volumeMounts:
        - name: tiered-storage-cache
          mountPath: /mnt/tiered-storage-cache
{{- if .Platform.TieredStorage.StaticCredentials }}
      env:
        - name: AWS_ACCESS_KEY_ID
          valueFrom:
            secretKeyRef: {name: tiered-storage-credentials, key: AWS_ACCESS_KEY_ID}
        - name: AWS_SECRET_ACCESS_KEY
          valueFrom:
            secretKeyRef: {name: tiered-storage-credentials, key: AWS_SECRET_ACCESS_KEY}
{{- end }}
---
apiVersion: kafka.strimzi.io/v1
kind: Kafka
metadata:
  name: {{ quote .ClusterName }}
  namespace: {{ .Namespace }}
  labels:
{{- template "labels" . }}
spec:
  kafka:
    version: {{ .KafkaVersion }}
    metadataVersion: {{ .MetadataVersion }}
{{- with .Platform.KafkaImage }}
    image: {{ . }}
{{- end }}
{{- if gt .Profile.Zones 1 }}
    # broker.rack, which clients set client.rack to, to read from a replica
    # in their own zone (docs/connecting.md).
    rack:
      topologyKey: {{ .Platform.RackLabel }}
{{- end }}
    listeners:
      # Platform clients inside the cluster, such as the Kafka agent.
      - name: tls
        port: {{ .InternalPort }}
        type: internal
        tls: true
        authentication:
          type: tls
      # Customers, over the internet.
      - name: external
        port: {{ .ExternalPort }}
        type: loadbalancer
        tls: true
        authentication:
          type: scram-sha-512
        configuration:
{{- with .Platform.LoadBalancer.Class }}
          class: {{ . }}
{{- end }}
{{- with .Platform.LoadBalancer.ExternalTrafficPolicy }}
          externalTrafficPolicy: {{ . }}
{{- end }}
          brokerCertChainAndKey:
            secretName: {{ .ExternalListenerSecret }}
            certificate: tls.crt
            key: tls.key
          bootstrap:
            annotations:
{{- range $key, $value := .BootstrapAnnotations }}
              {{ $key }}: {{ printf "%q" $value }}
{{- end }}
          advertisedHostTemplate: {{ .BrokerHostTemplate }}
          perBrokerAnnotationsTemplate:
{{- range $key, $value := .BrokerAnnotations }}
            {{ $key }}: {{ printf "%q" $value }}
{{- end }}
    authorization:
      type: simple
    # Broker metrics on port 9404, which VictoriaMetrics scrapes with the
    # tenant label (docs/metrics-labels.md). Only what observability and
    # usage metering need, to keep the number of series per broker low. The
    # patterns match names before Prometheus appends _total to counters; JVM
    # and process metrics are always exported and trimmed when scraped. The
    # metrics clients push (KIP-714) come out of the same reporter as
    # clients_* series, which the allowList does not apply to; the Kafka
    # agent sets up which ones and how they are labelled.
    metricsConfig:
      type: strimziMetricsReporter
      values:
        allowList:
          # Health: replication, controller, offline storage.
          - "kafka_server_replicamanager_(underreplicatedpartitions|underminisrpartitioncount|atminisrpartitioncount|offlinereplicacount|leadercount|partitioncount|isrshrinkspersec|isrexpandspersec|failedisrupdatespersec)"
          - "kafka_controller_kafkacontroller_(activecontrollercount|activebrokercount|fencedbrokercount|offlinepartitionscount|globalpartitioncount|globaltopiccount|preferredreplicaimbalancecount)"
          - "kafka_log_logmanager_offlinelogdirectorycount"
          - "kafka_server_kafkaserver_brokerstate"
          # Usage per topic: traffic, storage on the brokers and in S3.
          - "kafka_server_brokertopicmetrics_(bytesin|bytesout|messagesin|bytesrejected|totalproducerequests|totalfetchrequests|failedproducerequests|failedfetchrequests|remotecopybytes|remotecopyerrors|remotefetchbytes|remotefetcherrors)persec"
          - "kafka_server_brokertopicmetrics_(remotecopylagbytes|remotecopylagsegments|remotelogsizebytes)"
          - "kafka_log_log_size"
          # Load: requests, latency, connections, thread saturation.
          - "kafka_network_requestmetrics_requestspersec"
          - "kafka_network_requestmetrics_totaltimems.*"
          - "kafka_network_socketserver_networkprocessoravgidlepercent"
          - "kafka_server_kafkarequesthandlerpool_requesthandleravgidlepercent"
          - "kafka_server_socket_server_metrics_connection_count"
          - "kafka_coordinator_group_groupmetadatamanager_numgroups.*"
    # Topic history goes to S3 through the Aiven plugin in the Kafka image
    # (images/kafka). Topics opt in with remote.storage.enable=true.
    tieredStorage:
      type: custom
      remoteStorageManager:
        className: io.aiven.kafka.tieredstorage.RemoteStorageManager
        classPath: /opt/kafka/plugins/tiered-storage/*
        config:
          storage.backend.class: io.aiven.kafka.tieredstorage.storage.s3.S3Storage
          storage.s3.bucket.name: {{ quote .Platform.TieredStorage.Bucket }}
          storage.s3.region: {{ quote .Platform.TieredStorage.Region }}
{{- with .Platform.TieredStorage.Endpoint }}
          storage.s3.endpoint.url: {{ quote . }}
          storage.s3.path.style.access.enabled: "true"
{{- end }}
          key.prefix: {{ quote .TieredStoragePrefix }}
          chunk.size: "4194304"
          fetch.chunk.cache.class: io.aiven.kafka.tieredstorage.fetch.cache.DiskChunkCache
          fetch.chunk.cache.path: /mnt/tiered-storage-cache
          # 2 GiB, inside the cache volume's 3 GiB.
          fetch.chunk.cache.size: "2147483648"
    config:
      auto.create.topics.enable: false
      # Tiered topics keep a day on the brokers' disks; the rest is in S3.
      log.local.retention.ms: 86400000
      rlmm.config.remote.log.metadata.topic.replication.factor: {{ .Profile.ReplicationFactor }}
{{- if gt .Profile.Zones 1 }}
      # Follower fetching: consumers that set client.rack read from a replica
      # in their own zone, avoiding cross-zone transfer.
      replica.selector.class: org.apache.kafka.common.replica.RackAwareReplicaSelector
{{- end }}
      default.replication.factor: {{ .Profile.ReplicationFactor }}
      min.insync.replicas: {{ .Profile.MinInsyncReplicas }}
      offsets.topic.replication.factor: {{ .Profile.ReplicationFactor }}
      transaction.state.log.replication.factor: {{ .Profile.ReplicationFactor }}
      transaction.state.log.min.isr: {{ .Profile.MinInsyncReplicas }}
{{- range $key, $value := .Platform.KafkaConfig }}
      {{ $key }}: {{ quote $value }}
{{- end }}
  entityOperator:
{{- if .Platform.DedicatedNodes }}
    template:
      pod:
        affinity:
          nodeAffinity: {{ template "tenant-node-affinity" . }}
        tolerations: {{ template "tenant-tolerations" . }}
{{- end }}
    topicOperator: {}
    userOperator: {}
---
# The customer's user. It manages topics, consumer groups and transactions,
# but cannot change the cluster's configuration, which the platform owns.
apiVersion: kafka.strimzi.io/v1
kind: KafkaUser
metadata:
  name: {{ .AdminUser }}
  namespace: {{ .Namespace }}
  labels:
    strimzi.io/cluster: {{ quote .ClusterName }}
{{- template "labels" . }}
spec:
  authentication:
    type: scram-sha-512
  authorization:
    type: simple
    acls:
      - resource:
          type: topic
          name: "*"
          patternType: literal
        operations: [All]
      - resource:
          type: group
          name: "*"
          patternType: literal
        operations: [All]
      - resource:
          type: transactionalId
          name: "*"
          patternType: literal
        operations: [All]
      - resource:
          type: cluster
        operations: [Describe, DescribeConfigs, IdempotentWrite]
---
# The Kafka agent's user on the internal listener: it reads the cluster,
# keeps topic settings such as tiered storage in place, and reads consumer
# groups' committed offsets to measure their lag. It cannot read messages.
# It also keeps client telemetry in place, a client metrics subscription and
# a dynamic broker config, both of which Kafka authorizes as cluster configs.
apiVersion: kafka.strimzi.io/v1
kind: KafkaUser
metadata:
  name: {{ .AgentUser }}
  namespace: {{ .Namespace }}
  labels:
    strimzi.io/cluster: {{ quote .ClusterName }}
{{- template "labels" . }}
spec:
  authentication:
    type: tls
  authorization:
    type: simple
    acls:
      - resource:
          type: topic
          name: "*"
          patternType: literal
        operations: [Describe, DescribeConfigs, AlterConfigs]
      - resource:
          type: group
          name: "*"
          patternType: literal
        operations: [Describe]
      - resource:
          type: cluster
        operations: [Describe, DescribeConfigs, AlterConfigs]
---
# The console's user on the internal listener: it manages the customer's
# topics within the platform's guardrails, reads cluster metadata and which
# consumer groups read a topic, and cannot read or write messages.
apiVersion: kafka.strimzi.io/v1
kind: KafkaUser
metadata:
  name: {{ .ConsoleUser }}
  namespace: {{ .Namespace }}
  labels:
    strimzi.io/cluster: {{ quote .ClusterName }}
{{- template "labels" . }}
spec:
  authentication:
    type: tls
  authorization:
    type: simple
    acls:
      - resource:
          type: topic
          name: "*"
          patternType: literal
        operations: [Create, Delete, Describe, DescribeConfigs]
      - resource:
          type: group
          name: "*"
          patternType: literal
        operations: [Describe]
      - resource:
          type: cluster
        operations: [Describe]
---
# Lets the console's service account read the Secrets it needs in this
# namespace, by name, and the pods, to show the brokers' health.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: changeport-console
  namespace: {{ .Namespace }}
  labels:
{{- template "labels" . }}
rules:
  - apiGroups: [""]
    resources: [secrets]
    resourceNames:
{{- range .ConsoleSecrets }}
      - {{ quote . }}
{{- end }}
    verbs: [get]
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: changeport-console
  namespace: {{ .Namespace }}
  labels:
{{- template "labels" . }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: changeport-console
subjects:
  - kind: ServiceAccount
    name: {{ .ConsoleServiceAccount }}
    namespace: {{ .ConsoleNamespace }}
{{- with .Platform.AgentImage }}
---
# The Kafka agent (cmd/agent) keeps the platform's topic settings in place:
# it turns on tiered storage for every topic that can use it.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: changeport-agent
  namespace: {{ $.Namespace }}
  labels:
    app.kubernetes.io/name: changeport-agent
{{- template "labels" $ }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: changeport-agent
  template:
    metadata:
      labels:
        app.kubernetes.io/name: changeport-agent
        changeport.io/tenant: {{ quote $.Tenant }}
        changeport.io/kafka-cluster: {{ quote $.ClusterName }}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
{{- if $.Platform.DedicatedNodes }}
      affinity:
        nodeAffinity: {{ template "tenant-node-affinity" $ }}
      tolerations: {{ template "tenant-tolerations" $ }}
{{- end }}
      containers:
        - name: agent
          image: {{ . }}
          args:
            - "-bootstrap={{ $.ClusterName }}-kafka-bootstrap.{{ $.Namespace }}.svc:{{ $.InternalPort }}"
{{- with $.Platform.ClientMetricsInterval }}
            - "-client-metrics-interval={{ . }}"
{{- end }}
          ports:
            - name: metrics
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /readyz
              port: metrics
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz
              port: metrics
            periodSeconds: 30
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          volumeMounts:
            - name: agent-user
              mountPath: /etc/changeport/agent-user
              readOnly: true
            - name: cluster-ca
              mountPath: /etc/changeport/cluster-ca
              readOnly: true
      volumes:
        # The certificate of the agent's KafkaUser, from the User Operator.
        - name: agent-user
          secret:
            secretName: {{ $.AgentUser }}
        - name: cluster-ca
          secret:
            secretName: {{ $.ClusterCASecret }}
{{- end }}
{{- if .CDC }}
---
# The Kafka Connect worker's user on the internal listener, for the customer's
# Postgres CDC sources (docs/cdc.md). It creates and writes each source's
# topics, but never reads the customer's topics.
apiVersion: kafka.strimzi.io/v1
kind: KafkaUser
metadata:
  name: {{ .CDC.ConnectUser }}
  namespace: {{ .Namespace }}
  labels:
    strimzi.io/cluster: {{ quote .ClusterName }}
{{- template "cdc-labels" . }}
spec:
  authentication:
    type: tls
  authorization:
    type: simple
    acls:
      # Connect's own topics, of connector configurations, offsets and status,
      # and its group.
      - resource:
          type: topic
          name: changeport.connect.
          patternType: prefix
        operations: [Create, Describe, DescribeConfigs, Read, Write]
      - resource:
          type: group
          name: changeport.connect
          patternType: literal
        operations: [Describe, Read]
      # The sources' snapshot signals, progress notifications and heartbeats.
      - resource:
          type: topic
          name: changeport.cdc.
          patternType: prefix
        operations: [Create, Describe, DescribeConfigs, Read, Write]
      - resource:
          type: group
          name: changeport.cdc.
          patternType: prefix
        operations: [Describe, Read]
{{- range .CDC.Sources }}
      # The topics of source {{ .Name }}'s tables.
      - resource:
          type: topic
          name: {{ quote (printf "%s." .Name) }}
          patternType: prefix
        operations: [Create, Describe, DescribeConfigs, Write]
{{- end }}
      - resource:
          type: cluster
        operations: [Describe, DescribeConfigs]
---
# The schema registry's user on the internal listener: it keeps its schemas
# in its own topics, and touches nothing else.
apiVersion: kafka.strimzi.io/v1
kind: KafkaUser
metadata:
  name: {{ .CDC.RegistryUser }}
  namespace: {{ .Namespace }}
  labels:
    strimzi.io/cluster: {{ quote .ClusterName }}
{{- template "cdc-labels" . }}
spec:
  authentication:
    type: tls
  authorization:
    type: simple
    acls:
      - resource:
          type: topic
          name: changeport.registry.
          patternType: prefix
        operations: [Create, Describe, DescribeConfigs, Read, Write]
      - resource:
          type: group
          name: changeport.registry.
          patternType: prefix
        operations: [Describe, Read]
      - resource:
          type: cluster
        operations: [Describe, DescribeConfigs]
---
# What the Kafka Connect worker's JMX exporter exports: Debezium's streaming
# metrics and each connector's and task's state, labelled with their source.
# Only what the rules match is exported, besides the JVM's own metrics.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ .CDC.ConnectCluster }}-metrics
  namespace: {{ .Namespace }}
  labels:
{{- template "cdc-labels" . }}
data:
  metrics.yaml: |
    lowercaseOutputName: true
    lowercaseOutputLabelNames: true
    includeObjectNames: ["debezium.postgres:*", "kafka.connect:*"]
    rules:
      # How far behind its database each source is, whether it is
      # connected, and what it has read. server is the source's name. The
      # exporter matches "<bean><>attribute: value", so the colon keeps
      # MilliSecondsBehindSource from matching its averages too.
      - pattern: "debezium.postgres<type=connector-metrics, context=streaming, server=([^>]+)><>(MilliSecondsBehindSource|MilliSecondsSinceLastEvent|Connected|TotalNumberOfEventsSeen|NumberOfCommittedTransactions|QueueRemainingCapacity|QueueTotalCapacity):"
        name: debezium_streaming_$2
        labels:
          source: "$1"
      # The state of each source's connector and task: running, paused,
      # stopped, failed or unassigned. Connectors are named <source>-<id>.
      - pattern: "kafka.connect<type=connector-metrics, connector=([^>]+)-([a-z0-9]{6})><>status: ([a-z-]+)"
        name: kafka_connect_connector_status
        value: 1
        labels:
          source: "$1"
          status: "$3"
      - pattern: "kafka.connect<type=connector-task-metrics, connector=([^>]+)-([a-z0-9]{6}), task=([0-9]+)><>status: ([a-z-]+)"
        name: kafka_connect_task_status
        value: 1
        labels:
          source: "$1"
          task: "$3"
          status: "$4"
      # Records each source's task wrote to Kafka, and errors on the way.
      - pattern: "kafka.connect<type=source-task-metrics, connector=([^>]+)-([a-z0-9]{6}), task=([0-9]+)><>source-record-(write|poll)-total"
        name: kafka_connect_source_record_$4
        type: COUNTER
        labels:
          source: "$1"
          task: "$3"
      - pattern: "kafka.connect<type=task-error-metrics, connector=([^>]+)-([a-z0-9]{6}), task=([0-9]+)><>total-record-(errors|failures)"
        name: kafka_connect_task_record_$4
        type: COUNTER
        labels:
          source: "$1"
          task: "$3"
---
# The Kafka Connect worker that runs the customer's Postgres CDC sources, one
# KafkaConnector each, with Debezium and Apicurio's Avro converter
# (images/connect).
apiVersion: kafka.strimzi.io/v1
kind: KafkaConnect
metadata:
  name: {{ .CDC.ConnectCluster }}
  namespace: {{ .Namespace }}
  labels:
{{- template "cdc-labels" . }}
  annotations:
    strimzi.io/use-connector-resources: "true"
spec:
  version: {{ .KafkaVersion }}
  image: {{ .Platform.ConnectImage }}
  replicas: 1
  bootstrapServers: "{{ .ClusterName }}-kafka-bootstrap:{{ .InternalPort }}"
  groupId: changeport.connect
  configStorageTopic: changeport.connect.configs
  offsetStorageTopic: changeport.connect.offsets
  statusStorageTopic: changeport.connect.status
  tls:
    trustedCertificates:
      - secretName: {{ .ClusterCASecret }}
        certificate: ca.crt
  authentication:
    type: tls
    certificateAndKey:
      secretName: {{ .CDC.ConnectUser }}
      certificate: user.crt
      key: user.key
  config:
    config.storage.replication.factor: {{ .Profile.ReplicationFactor }}
    offset.storage.replication.factor: {{ .Profile.ReplicationFactor }}
    status.storage.replication.factor: {{ .Profile.ReplicationFactor }}
    # Connector configurations name the files of the mounted Secrets rather
    # than holding passwords: ${directory:/mnt/sources:<source>}.
    config.providers: directory
    config.providers.directory.class: org.apache.kafka.common.config.provider.DirectoryConfigProvider
  resources:
    requests:
      cpu: "{{ .Profile.ConnectCPURequest }}"
      memory: "{{ .Profile.ConnectMemory }}"
    limits:
      memory: "{{ .Profile.ConnectMemory }}"
  # Debezium's and Connect's metrics on port 9404, which VictoriaMetrics
  # scrapes with the tenant label (docs/metrics-labels.md).
  metricsConfig:
    type: jmxPrometheusExporter
    valueFrom:
      configMapKeyRef:
        name: {{ .CDC.ConnectCluster }}-metrics
        key: metrics.yaml
  # Strimzi's default heap of three quarters of the memory leaves too little
  # for the rest of the worker.
  jvmOptions:
    "-Xms": "{{ .Profile.ConnectHeap }}"
    "-Xmx": "{{ .Profile.ConnectHeap }}"
  template:
    pod:
{{- template "cdc-placement" . }}
      volumes:
        # The sources' database passwords, which the source controller writes.
        - name: sources
          secret:
            secretName: {{ .CDC.ConnectSourcesSecret }}
            optional: true
        # The worker's own certificate and the cluster CA, for the clients
        # Debezium starts itself, such as the snapshot signal consumer.
        - name: connect-user
          secret:
            secretName: {{ .CDC.ConnectUser }}
        - name: cluster-ca
          secret:
            secretName: {{ .ClusterCASecret }}
    connectContainer:
      volumeMounts:
        - name: sources
          mountPath: /mnt/sources
        - name: connect-user
          mountPath: /mnt/connect-user
        - name: cluster-ca
          mountPath: /mnt/cluster-ca
{{- range .CDC.Sources }}
{{- $source := .Name }}
---
# Source {{ $source }}'s snapshot signals: the source controller asks for the
# existing rows of its tables here, and the connector reads them.
apiVersion: kafka.strimzi.io/v1
kind: KafkaTopic
metadata:
  name: changeport.cdc.signals.{{ $source }}
  namespace: {{ $.Namespace }}
  labels:
    strimzi.io/cluster: {{ quote $.ClusterName }}
    changeport.io/source: {{ $source }}
{{- template "cdc-labels" $ }}
spec:
  topicName: changeport.cdc.signals.{{ $source }}
  partitions: 1
  replicas: {{ $.Profile.ReplicationFactor }}
  config:
    cleanup.policy: delete
    retention.ms: "604800000"
    # The Kafka agent tiers every topic that can be; saying so here keeps
    # the Topic Operator from trying to undo it.
    remote.storage.enable: "true"
---
# Source {{ $source }}'s snapshot progress, which the connector reports and
# the source controller follows.
apiVersion: kafka.strimzi.io/v1
kind: KafkaTopic
metadata:
  name: changeport.cdc.notifications.{{ $source }}
  namespace: {{ $.Namespace }}
  labels:
    strimzi.io/cluster: {{ quote $.ClusterName }}
    changeport.io/source: {{ $source }}
{{- template "cdc-labels" $ }}
spec:
  topicName: changeport.cdc.notifications.{{ $source }}
  partitions: 1
  replicas: {{ $.Profile.ReplicationFactor }}
  config:
    cleanup.policy: delete
    retention.ms: "604800000"
    # The Kafka agent tiers every topic that can be; saying so here keeps
    # the Topic Operator from trying to undo it.
    remote.storage.enable: "true"
{{- with .Connector }}
---
# Source {{ $source }}'s Debezium connector: it streams the changes of the
# source's tables from the customer's database, through its publication and
# its own replication slot, into a topic per table, as Avro.
apiVersion: kafka.strimzi.io/v1
kind: KafkaConnector
metadata:
  name: {{ .Name }}
  namespace: {{ $.Namespace }}
  labels:
    strimzi.io/cluster: {{ $.CDC.ConnectCluster }}
    changeport.io/source: {{ $source }}
{{- template "cdc-labels" $ }}
spec:
  class: io.debezium.connector.postgresql.PostgresConnector
  tasksMax: 1
  state: {{ if .Running }}running{{ else }}stopped{{ end }}
  autoRestart:
    enabled: true
  config:
    database.hostname: {{ quote .Host }}
    database.port: {{ .Port }}
    database.dbname: {{ quote .Database }}
    database.user: {{ quote .Role }}
    database.password: "${directory:/mnt/sources:{{ $source }}}"
    database.sslmode: {{ .TLSMode }}
{{- if .CA }}
    database.sslrootcert: /mnt/sources/{{ $source }}.ca
{{- else }}
    # The public authorities the JVM trusts.
    database.sslfactory: org.postgresql.ssl.DefaultJavaSSLFactory
{{- end }}
    # Changes as the credentials do, which restarts the connector with them.
    changeport.credentials.version: {{ quote .CredentialsVersion }}
    topic.prefix: {{ $source }}
    plugin.name: pgoutput
    publication.name: {{ .Publication }}
    publication.autocreate.mode: disabled
    slot.name: {{ .Slot }}
    table.include.list: {{ quote .TableIncludeList }}
    # Existing rows arrive through read-only incremental snapshots, which
    # the source controller asks for on the signal topic: in chunks, while
    # changes stream, without locks or writes to the customer's database.
    snapshot.mode: no_data
    read.only: true
    incremental.snapshot.chunk.size: {{ $.CDC.SnapshotChunkSize }}
    signal.enabled.channels: kafka
    signal.kafka.topic: changeport.cdc.signals.{{ $source }}
    signal.kafka.groupId: changeport.cdc.signals.{{ $source }}
    signal.kafka.bootstrap.servers: "{{ $.ClusterName }}-kafka-bootstrap:{{ $.InternalPort }}"
    signal.consumer.security.protocol: SSL
    signal.consumer.ssl.keystore.type: PKCS12
    signal.consumer.ssl.keystore.location: /mnt/connect-user/user.p12
    signal.consumer.ssl.keystore.password: "${directory:/mnt/connect-user:user.password}"
    signal.consumer.ssl.truststore.type: PKCS12
    signal.consumer.ssl.truststore.location: /mnt/cluster-ca/ca.p12
    signal.consumer.ssl.truststore.password: "${directory:/mnt/cluster-ca:ca.password}"
    notification.enabled.channels: sink
    notification.sink.topic.name: changeport.cdc.notifications.{{ $source }}
    # A transactional logical message every minute lets the slot advance
    # while the source's tables are idle; Debezium drops the messages.
    heartbeat.interval.ms: 60000
    heartbeat.action.query: "SELECT pg_logical_emit_message(true, 'changeport-heartbeat', '')"
    message.prefix.exclude.list: changeport-heartbeat
    topic.heartbeat.prefix: changeport.cdc.heartbeat
    tombstones.on.delete: true
    # Avro names allow fewer characters than Postgres's.
    schema.name.adjustment.mode: avro
    field.name.adjustment.mode: avro
    key.converter: io.apicurio.registry.utils.converter.AvroConverter
    key.converter.apicurio.registry.url: {{ $.CDC.RegistryURL }}
    key.converter.apicurio.registry.auto-register: true
    key.converter.apicurio.registry.headers.enabled: false
    value.converter: io.apicurio.registry.utils.converter.AvroConverter
    value.converter.apicurio.registry.url: {{ $.CDC.RegistryURL }}
    value.converter.apicurio.registry.auto-register: true
    value.converter.apicurio.registry.headers.enabled: false
    # One partition per table, keyed by the primary key, with the source's
    # retention.
    topic.creation.default.partitions: 1
    topic.creation.default.replication.factor: {{ $.Profile.ReplicationFactor }}
    topic.creation.default.cleanup.policy: delete
    topic.creation.default.retention.ms: "{{ .RetentionMs }}"
{{- with .LocalRetentionMs }}
    topic.creation.default.local.retention.ms: "{{ . }}"
{{- end }}
{{- end }}
{{- end }}
---
# The schema registry, Apicurio Registry, which keeps the Avro schemas of the
# sources' topics in the customer's Kafka. Customers reach it through the
# registry gateway; the Connect worker inside the cluster.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .CDC.Registry }}
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/name: {{ .CDC.Registry }}
{{- template "cdc-labels" . }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .CDC.Registry }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ .CDC.Registry }}
        changeport.io/tenant: {{ quote .Tenant }}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
{{- template "cdc-placement" . }}
      containers:
        - name: registry
          image: {{ .CDC.RegistryImage }}
          env:
            - name: APICURIO_STORAGE_KIND
              value: kafkasql
            - name: APICURIO_KAFKASQL_BOOTSTRAP_SERVERS
              value: "{{ .ClusterName }}-kafka-bootstrap:{{ .InternalPort }}"
            - name: APICURIO_KAFKASQL_TOPIC
              value: changeport.registry.journal
            - name: APICURIO_KAFKASQL_SNAPSHOTS_TOPIC
              value: changeport.registry.snapshots
            - name: APICURIO_EVENTS_KAFKA_TOPIC
              value: changeport.registry.events
            - name: APICURIO_KAFKASQL_CONSUMER_GROUP_PREFIX
              value: changeport.registry.
            - name: APICURIO_KAFKASQL_SECURITY_PROTOCOL
              value: SSL
            - name: APICURIO_KAFKASQL_SECURITY_SSL_KEYSTORE_TYPE
              value: PKCS12
            - name: APICURIO_KAFKASQL_SECURITY_SSL_KEYSTORE_LOCATION
              value: /mnt/user/user.p12
            - name: APICURIO_KAFKASQL_SECURITY_SSL_KEYSTORE_PASSWORD
              valueFrom:
                secretKeyRef: {name: {{ .CDC.RegistryUser }}, key: user.password}
            - name: APICURIO_KAFKASQL_SECURITY_SSL_TRUSTSTORE_TYPE
              value: PKCS12
            - name: APICURIO_KAFKASQL_SECURITY_SSL_TRUSTSTORE_LOCATION
              value: /mnt/cluster-ca/ca.p12
            - name: APICURIO_KAFKASQL_SECURITY_SSL_TRUSTSTORE_PASSWORD
              valueFrom:
                secretKeyRef: {name: {{ .ClusterCASecret }}, key: ca.password}
          ports:
            - name: http
              containerPort: {{ .CDC.RegistryPort }}
            - name: management
              containerPort: {{ .CDC.RegistryManagementPort }}
          readinessProbe:
            httpGet:
              path: /health/ready
              port: management
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health/live
              port: management
            initialDelaySeconds: 60
            periodSeconds: 30
          resources:
            requests:
              cpu: "{{ .Profile.RegistryCPURequest }}"
              memory: "{{ .Profile.RegistryMemory }}"
            limits:
              memory: "{{ .Profile.RegistryMemory }}"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          volumeMounts:
            - name: user
              mountPath: /mnt/user
              readOnly: true
            - name: cluster-ca
              mountPath: /mnt/cluster-ca
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        # The certificate of the registry's KafkaUser, from the User Operator.
        - name: user
          secret:
            secretName: {{ .CDC.RegistryUser }}
        - name: cluster-ca
          secret:
            secretName: {{ .ClusterCASecret }}
        - name: tmp
          emptyDir:
            sizeLimit: 64Mi
---
apiVersion: v1
kind: Service
metadata:
  name: {{ .CDC.Registry }}
  namespace: {{ .Namespace }}
  labels:
{{- template "cdc-labels" . }}
spec:
  selector:
    app.kubernetes.io/name: {{ .CDC.Registry }}
  ports:
    - name: http
      port: {{ .CDC.RegistryPort }}
      targetPort: http
---
# The Connect worker reaches only DNS, the brokers, the registry, the other
# workers, the Kubernetes API, which Strimzi's config provider reads its
# certificates from, and databases on the internet; never the cluster's own
# networks or the cloud's metadata service.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ .CDC.ConnectCluster }}-egress
  namespace: {{ .Namespace }}
  labels:
{{- template "cdc-labels" . }}
spec:
  podSelector: {{ template "connect-selector" . }}
  policyTypes: [Egress]
  egress:
    - ports:
        - {protocol: UDP, port: 53}
        - {protocol: TCP, port: 53}
    - to:
        - podSelector: {matchLabels: {strimzi.io/cluster: {{ quote .ClusterName }}, strimzi.io/kind: Kafka}}
      ports:
        - {protocol: TCP, port: {{ .InternalPort }}}
    - to:
        - podSelector: {{ template "registry-selector" . }}
      ports:
        - {protocol: TCP, port: {{ .CDC.RegistryPort }}}
    - to:
        - podSelector: {{ template "connect-selector" . }}
      ports:
        - {protocol: TCP, port: 8083}
{{- range .CDC.KubernetesAPI }}
    - to:
        - ipBlock: {cidr: {{ .CIDR }}}
      ports:
        - {protocol: TCP, port: {{ .Port }}}
{{- end }}
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
            except:
{{- range .CDC.PrivateRanges }}
              - {{ . }}
{{- end }}
{{- with .Platform.SourceDatabaseNamespace }}
    # The databases that stand in for customers' on this platform.
    - to:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: {{ . }}}}
{{- end }}
---
# Only the Connect worker reaches the registry, the source controller, which
# decodes the snapshot notifications with its schemas, and the registry
# gateway; the registry reaches only DNS and the brokers.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ .CDC.Registry }}
  namespace: {{ .Namespace }}
  labels:
{{- template "cdc-labels" . }}
spec:
  podSelector: {{ template "registry-selector" . }}
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - podSelector: {{ template "connect-selector" . }}
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: {{ .ConsoleNamespace }}}}
          podSelector: {matchLabels: {app.kubernetes.io/name: changeport-provisioner}}
{{- with .CDC.Gateway }}
        - podSelector: {matchLabels: {app.kubernetes.io/name: {{ .Name }}}}
{{- end }}
      ports:
        - {protocol: TCP, port: {{ .CDC.RegistryPort }}}
  egress:
    - ports:
        - {protocol: UDP, port: 53}
        - {protocol: TCP, port: 53}
    - to:
        - podSelector: {matchLabels: {strimzi.io/cluster: {{ quote .ClusterName }}, strimzi.io/kind: Kafka}}
      ports:
        - {protocol: TCP, port: {{ .InternalPort }}}
{{- with .CDC.Gateway }}
---
# The registry gateway (cmd/registry-gateway): customers' clients reach their
# schema registry through it from the internet, at {{ .Host }}, over TLS
# on the cluster's certificate, with their Kafka credentials. It refuses
# changes to the sources' schemas.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Name }}
  namespace: {{ $.Namespace }}
  labels:
    app.kubernetes.io/name: {{ .Name }}
{{- template "cdc-labels" $ }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .Name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ .Name }}
        changeport.io/tenant: {{ quote $.Tenant }}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
{{- template "cdc-placement" $ }}
      containers:
        - name: gateway
          image: {{ .Image }}
          args:
            - "-upstream=http://{{ $.CDC.Registry }}:{{ $.CDC.RegistryPort }}/apis/ccompat/v7"
            - "-username={{ $.AdminUser }}"
            - "-sources={{ .Sources }}"
          ports:
            - name: https
              containerPort: 8443
            - name: health
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: health
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
            periodSeconds: 30
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          volumeMounts:
            - name: kafka-user
              mountPath: /etc/changeport/kafka-user
              readOnly: true
            - name: tls
              mountPath: /etc/changeport/tls
              readOnly: true
      volumes:
        # The customer's Kafka user's password, which the gateway checks.
        - name: kafka-user
          secret:
            secretName: {{ $.AdminUser }}
            items: [{key: password, path: password}]
        # The public listener's certificate, whose wildcard name covers the
        # gateway's.
        - name: tls
          secret:
            secretName: {{ $.ExternalListenerSecret }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ .Name }}
  namespace: {{ $.Namespace }}
  labels:
{{- template "cdc-labels" $ }}
  annotations:
{{- range $key, $value := .Annotations }}
    {{ $key }}: {{ printf "%q" $value }}
{{- end }}
spec:
  type: LoadBalancer
{{- with $.Platform.LoadBalancer.Class }}
  loadBalancerClass: {{ . }}
{{- end }}
{{- with $.Platform.LoadBalancer.ExternalTrafficPolicy }}
  externalTrafficPolicy: {{ . }}
{{- end }}
  selector:
    app.kubernetes.io/name: {{ .Name }}
  ports:
    - name: https
      port: {{ $.CDC.RegistryGatewayPort }}
      targetPort: https
---
# The gateway takes customers' connections from anywhere, and reaches only
# DNS and the registry.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ .Name }}
  namespace: {{ $.Namespace }}
  labels:
{{- template "cdc-labels" $ }}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: {{ .Name }}}}
  policyTypes: [Ingress, Egress]
  ingress:
    - ports:
        - {protocol: TCP, port: 8443}
  egress:
    - ports:
        - {protocol: UDP, port: 53}
        - {protocol: TCP, port: 53}
    - to:
        - podSelector: {{ template "registry-selector" $ }}
      ports:
        - {protocol: TCP, port: {{ $.CDC.RegistryPort }}}
{{- end }}
{{- end }}
