# The console's Clerk configuration on kind. Copy this file to .env, which
# git ignores, fill it in from your Clerk development instance, and run
# just console-config (just dev-up does too). Without it the console fails
# closed and refuses every API call.

# Configure > API keys: the publishable key (pk_test_...) and the secret key
# (sk_test_...). Keep the secret key out of chats and commits.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Organizations > Changeport staff: its ID (org_...). Its members are
# Changeport's operators.
CHANGEPORT_STAFF_ORG_ID=

# Optional: your name for your Clerk test user, <name>+clerk_test@example.com,
# which just dev-up makes an operator and the demo customer's admin (sign in
# with the code 424242). Default: the start of your git email address, up to
# a dot or plus sign. none turns the dev user off.
CHANGEPORT_DEV_USER=
